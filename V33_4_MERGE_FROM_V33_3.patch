+-- v33.4: A single, permission-scoped administrator UI for certificate referees
+-- and RoV match administrators. The two existing permission tables are retained.
+-- Prerequisites: migrations 202611220025 and 202611230027.
+-- Does NOT grant or revoke any existing rights, and does NOT change sports results.
+begin;
+
+-- Google callback can recognize an assigned certificate referee without
+-- granting that referee access to other sports or competition administration.
+create or replace function public.sports_cert_my_access()
+returns boolean language sql stable security definer set search_path='' as $$
+  select auth.uid() is not null and exists (
+    select 1 from public.sports_certificate_officials o
+      join auth.users u on u.id=auth.uid()
+      join public.sports_events e on e.id=o.event_id and e.competition_id=o.competition_id
+      join public.sports_competitions c on c.id=e.competition_id
+        and c.slug='phayao-secondary-group-sports-2569'
+    where o.is_active
+      and o.email=lower(btrim(u.email))
+      and u.email_confirmed_at is not null
+      and exists (select 1 from auth.identities i
+                  where i.user_id=u.id and i.provider='google')
+  );
+$$;
+revoke all on function public.sports_cert_my_access() from public,anon;
+grant execute on function public.sports_cert_my_access() to authenticated;
+
+-- Read-only consolidated permission roster, limited to principal competition admins.
+-- An E-Sport match administrator is competition-wide for both RoV categories,
+-- whereas certificate recording permission is granted per event.
+create or replace function public.sports_officials_access_overview(p_event uuid)
+returns jsonb language plpgsql stable security definer set search_path='' as $$
+declare
+  v_comp uuid;
+  v_is_esports boolean;
+  v_rows jsonb;
+begin
+  select e.competition_id, e.event_code in ('GS3-ES-SM','GS3-ES-SF')
+    into v_comp,v_is_esports from public.sports_events e where e.id=p_event;
+  if v_comp is null or not exists(
+    select 1 from public.sports_competitions c where c.id=v_comp
+      and c.slug='phayao-secondary-group-sports-2569'
+  ) or not public.sports_stage3_admin(v_comp) then
+    raise exception 'เฉพาะผู้ดูแลการแข่งขันหลักเท่านั้นที่จัดการสิทธิ์กรรมการได้' using errcode='42501';
+  end if;
+
+  select coalesce(jsonb_agg(jsonb_build_object(
+    'email', people.email,
+    'certificate_active', coalesce(cert.is_active,false),
+    'esports_active', case when v_is_esports then coalesce(es.is_active,false) else false end,
+    'login_ready', (u.id is not null and u.email_confirmed_at is not null and
+       exists(select 1 from auth.identities i where i.user_id=u.id and i.provider='google')),
+    'login_status', case
+      when u.id is null then 'not_signed_in'
+      when u.email_confirmed_at is null then 'unconfirmed_email'
+      when not exists(select 1 from auth.identities i where i.user_id=u.id and i.provider='google') then 'not_google'
+      else 'ready'
+    end
+  ) order by people.email),'[]'::jsonb) into v_rows
+  from (
+    select o.email from public.sports_certificate_officials o
+     where o.event_id=p_event
+    union
+    select a.email from public.sports_esports_admins a
+     where v_is_esports and a.competition_id=v_comp
+  ) people
+  left join public.sports_certificate_officials cert
+    on cert.event_id=p_event and cert.email=people.email
+  left join public.sports_esports_admins es
+    on v_is_esports and es.competition_id=v_comp and es.email=people.email
+  left join lateral (
+    select au.id,au.email_confirmed_at from auth.users au
+      where lower(btrim(au.email))=people.email limit 1
+  ) u on true;
+  return coalesce(v_rows,'[]'::jsonb);
+end;
+$$;
+revoke all on function public.sports_officials_access_overview(uuid) from public,anon;
+grant execute on function public.sports_officials_access_overview(uuid) to authenticated;
+
+-- Atomic role change: only the explicitly selected scope is modified.
+-- 'both' is permitted only on either official E-Sport event.
+create or replace function public.sports_officials_assign(
+  p_event uuid, p_email text, p_scope text, p_active boolean default true
+) returns jsonb language plpgsql security definer set search_path='' as $$
+declare
+  v_comp uuid;
+  v_code text;
+  v_email text:=lower(btrim(coalesce(p_email,'')));
+begin
+  select e.competition_id,e.event_code into v_comp,v_code
+    from public.sports_events e where e.id=p_event;
+  if v_comp is null or not exists(
+    select 1 from public.sports_competitions c where c.id=v_comp
+      and c.slug='phayao-secondary-group-sports-2569'
+  ) or not public.sports_stage3_admin(v_comp) then
+    raise exception 'ไม่มีสิทธิ์มอบหมายกรรมการ' using errcode='42501';
+  end if;
+  if p_scope not in ('certificate','esports','both') or p_scope is null
+     or p_active is null or v_email !~ '^[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$'
+     or length(v_email)>254 then
+    raise exception 'ข้อมูลสิทธิ์กรรมการไม่ถูกต้อง';
+  end if;
+  if p_scope in ('esports','both') and v_code not in ('GS3-ES-SM','GS3-ES-SF') then
+    raise exception 'สิทธิ์ดูแล RoV ใช้ได้เฉพาะรายการ E-Sport' using errcode='42501';
+  end if;
+  if p_scope in ('certificate','both') then
+    perform public.sports_cert_set_official(p_event,v_email,p_active);
+  end if;
+  if p_scope in ('esports','both') then
+    perform public.sports_esports_set_admin(v_comp,v_email,p_active);
+  end if;
+  return jsonb_build_object('email',v_email,'scope',p_scope,'is_active',p_active);
+end;
+$$;
+revoke all on function public.sports_officials_assign(uuid,text,text,boolean) from public,anon;
+grant execute on function public.sports_officials_assign(uuid,text,text,boolean) to authenticated;
+
+commit;
